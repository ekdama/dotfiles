{
  "version": "0.2.0",
  "tasks": [
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",               // Debug symbols
        "-O0",              // No optimizations (better debugging)
        "-DEVAL",
        "-std=gnu11",
        "-Wall",            // Enable warnings
        "-Werror",          // Extra warnings
        "-o", "${workspaceFolder}/build/Debug/OutDebug",
        "${workspaceFolder}/src/*.c"  // Adjust to match your source files
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Build with debug flags (-g)"
    }
  ],
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/edo/notes/2s2a/API/progetto",
      "program": "/home/edo/notes/2s2a/API/progetto/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}